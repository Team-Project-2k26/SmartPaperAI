# ── Server ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./research_papers.db

# ── Upload ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# ── AI Models (open-source, no API keys required) ────────────────────────────
USE_ABSTRACTIVE_SUMMARY=true
SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
QA_MODEL=deepset/roberta-base-squad2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8000
# (Leave empty to use Vite dev proxy defined in vite.config.js)
